00, "groupIds": [], "frameId": null, "roundness": null, "seed": 1072153450, "version": 1, "versionNonce": 1941338468, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Réplica y\nrespaldos por\nlos túneles", "originalText": "Réplica y\nrespaldos por\nlos túneles", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "Re6kwws7udiqchgyopbZg", "type": "arrow", "x": 1930, "y": 1070, "width": 85, "height": 15, "angle": 0, "strokeColor": "#c2255c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 128879018, "version": 1, "versionNonce": 1680023333, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "points": [[0, 0], [85, -15]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": "arrow", "endArrowhead": "arrow"}, {"id": "RddZo9FpplQteqdzkr_ma", "type": "arrow", "x": 2070, "y": 1160, "width": 0, "height": 36, "angle": 0, "strokeColor": "#c2255c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 1443990769, "version": 1, "versionNonce": 748440343, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "points": [[0, 0], [0, 36]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "Eq2Bcfy-7Aa4h8tu-P163", "type": "arrow", "x": 2135, "y": 1260, "width": 103, "height": 0, "angle": 0, "strokeColor": "#c2255c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 1482975755, "version": 1, "versionNonce": 1093341239, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "points": [[0, 0], [103, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "ahFMtzgL1vk7HhLXmZjD3", "type": "rectangle", "x": 40, "y": 1560, "width": 2400, "height": 295, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1910411845, "version": 1, "versionNonce": 1330433619, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "YeetofELhQYbcosLdrfoa", "type": "text", "x": 60, "y": 1574, "width": 1078.0000000000002, "height": 35.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1882482720, "version": 1, "versionNonce": 1744460108, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Supuestos y límites de cada cuenta (para validar antes de implementar)", "originalText": "Supuestos y límites de cada cuenta (para validar antes de implementar)", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 25, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "uHRrA01MPKe1nA1FM3qVc", "type": "text", "x": 60, "y": 1624, "width": 683.1, "height": 180.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 74363381, "version": 1, "versionNonce": 463271900, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "AWS Academy (Learner Lab)\n• Lab de 4 h por sesión; presupuesto USD 50–100 según el curso\n• IAM: solo LabRole / LabInstanceProfile; no se crean usuarios\n• EC2 nano–large, ≤9 instancias y 32 vCPU por región; EBS ≤100 GB\n• Site-to-Site VPN no figura en la lista de servicios que revisé:\n  se prueba la creación de la Virtual Private Gateway antes de seguir\n  (Plan B: strongSwan en una EC2 como extremo IPsec)\n• VPN gestionada = USD 0.05 por hora y por conexión", "originalText": "AWS Academy (Learner Lab)\n• Lab de 4 h por sesión; presupuesto USD 50–100 según el curso\n• IAM: solo LabRole / LabInstanceProfile; no se crean usuarios\n• EC2 nano–large, ≤9 instancias y 32 vCPU por región; EBS ≤100 GB\n• Site-to-Site VPN no figura en la lista de servicios que revisé:\n  se prueba la creación de la Virtual Private Gateway antes de seguir\n  (Plan B: strongSwan en una EC2 como extremo IPsec)\n• VPN gestionada = USD 0.05 por hora y por conexión", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 16, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "UJGGz8ucbM67GkkHolykP", "type": "text", "x": 870, "y": 1624, "width": 603.9, "height": 157.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 7899630, "version": 1, "versionNonce": 1213234133, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Azure for Students\n• USD 100 de crédito durante 12 meses, sin tarjeta de crédito\n• No cubre ExpressRoute, Azure DevOps ni Marketplace\n• Los créditos de cada mes no se acumulan\n• Con 90 días sin uso pueden borrar los recursos de cómputo\n• VPN Gateway cobra por hora: crear y borrar en cada prueba;\n  confirmar precio del SKU en la calculadora de Azure", "originalText": "Azure for Students\n• USD 100 de crédito durante 12 meses, sin tarjeta de crédito\n• No cubre ExpressRoute, Azure DevOps ni Marketplace\n• Los créditos de cada mes no se acumulan\n• Con 90 días sin uso pueden borrar los recursos de cómputo\n• VPN Gateway cobra por hora: crear y borrar en cada prueba;\n  confirmar precio del SKU en la calculadora de Azure", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 16, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "lfOISlouU1qYNrrc-DUhs", "type": "text", "x": 1650, "y": 1624, "width": 673.2, "height": 180.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1069858425, "version": 1, "versionNonce": 1767802209, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "OCI Always Free\n• 2 VM AMD micro (1/8 OCPU, 1 GB) o Ampere A1 (hasta 2 OCPU / 12 GB)\n• 200 GB de almacenamiento en bloque; 20 GB en Object Storage\n• 2 VCN; IPsec con strongSwan en la VM (sin DRG ni CPE)\n• Compute y Block Volume solo en la home region\n• Reclamo de instancias inactivas (<20 % por 7 días)\n• Solo se usan recursos listados como Always Free:\n  VM A1, Block Volume, Object Storage, VCN, Bastion, Monitoring", "originalText": "OCI Always Free\n• 2 VM AMD micro (1/8 OCPU, 1 GB) o Ampere A1 (hasta 2 OCPU / 12 GB)\n• 200 GB de almacenamiento en bloque; 20 GB en Object Storage\n• 2 VCN; IPsec con strongSwan en la VM (sin DRG ni CPE)\n• Compute y Block Volume solo en la home region\n• Reclamo de instancias inactivas (<20 % por 7 días)\n• Solo se usan recursos listados como Always Free:\n  VM A1, Block Volume, Object Storage, VCN, Bastion, Monitoring", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 16, "containerId": null, "lineHeight": 1.25, "autoResize": true}], "appState": {"gridSize": null, "viewBackgroundColor": "#ffffff"}, "files": {}}