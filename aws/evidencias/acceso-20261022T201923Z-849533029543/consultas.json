    "argumentos": [
      "ec2",
      "describe-instances",
      "--filters",
      "Name=instance-state-name,Values=pending,running,stopping,stopped,shutting-down",
      "--query",
      "Reservations[].Instances[].{Id:InstanceId,State:State.Name,Vpc:VpcId,Subnet:SubnetId,Type:InstanceType,AZ:Placement.AvailabilityZone,Name:Tags[?Key==`Name`].Value|[0]}",
      "--region",
      "us-west-2"
    ]
  },
  {
    "nombre": "us-west-2-alb",
    "argumentos": [
      "elbv2",
      "describe-load-balancers",
      "--query",
      "LoadBalancers[].{Name:LoadBalancerName,Arn:LoadBalancerArn,Vpc:VpcId,DNS:DNSName,State:State.Code}",
      "--region",
      "us-west-2"
    ]
  },
  {
    "nombre": "us-west-2-asg",
    "argumentos": [
