      "--query",
      "AutoScalingGroups[].{Name:AutoScalingGroupName,Min:MinSize,Max:MaxSize,Desired:DesiredCapacity,Instances:Instances[].InstanceId,Subnets:VPCZoneIdentifier}",
      "--region",
      "us-west-2"
    ]
  },
  {
    "nombre": "us-west-2-nat",
    "argumentos": [
